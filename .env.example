# Copy to .env and fill in. The dataset preparation CLI
# (python -m streamlit_recommenders.data.prepare) loads this file automatically;
# real environment variables already set take precedence.

# TMDB — needed only for MovieLens poster/description enrichment (--with-posters).
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Alternative to TMDB_API_KEY:
# TMDB_BEARER_TOKEN=

# Kaggle — needed only if goodbooks-10k download requires credentials.
# From your kaggle.json (https://www.kaggle.com/settings):
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# Data directory the example apps read at runtime, e.g.:
# SR_DATA_DIR=data/ml-latest-small
